# ==============================================================================
# Web 平台管理员登录凭据配置 (部署到服务器后请修改密码)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
SECRET_KEY=jd_offer_monitor_secret_key_change_me_2026

# ==============================================================================
# 微信公众号（测试号）推送配置
# 申请地址：https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
# ==============================================================================

# 测试号 appID
WECHAT_APP_ID=

# 测试号 appsecret
WECHAT_APP_SECRET=

# 消息模板 ID（在测试号管理后台创建模板获得）
WECHAT_TEMPLATE_ID=

# 接收推送消息的微信 openid（关注测试号后在用户列表中查看）
WECHAT_OPENID=

# ==============================================================================
# 服务运行参数（可选）
# ==============================================================================
PORT=8080
# 是否开启代码文件变动热重载（生产环境建议 false，开发/调试建议 true）
RELOAD=false

# 本系统对外访问地址（用于微信卡片跳转专属时效快照页面，如 https://patrol.yourdomain.com 或 http://公网IP:8080）
# 若留空，则默认使用 http://127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
# 国内服务器如拉取官方 python 镜像超时，可取消注释使用国内代理镜像：
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim

# ==============================================================================
# 课时费计算管理系统 · 运营日报监控配置（可选插件）
# ==============================================================================
TEACH_FEE_API_URL=http://127.0.0.1:8000/api/v1/internal/daily-metrics
TEACH_FEE_API_KEY=watchpatrol_metrics_secret_2026
TEACH_FEE_DASHBOARD_URL=https://your-teach-fee-dashboard.com
TEACH_FEE_TEMPLATE_ID=
